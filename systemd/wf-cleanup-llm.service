[Unit]
Description=wisprflow cleanup LLM — isolated Ollama (f16 KV cache) for fast dictation post-processing
After=graphical-session.target

[Service]
Type=simple
# A SECOND, fully-isolated Ollama: own port, own models dir, and a NORMAL (f16) KV cache.
# The system Ollama uses q4_0 KV cache (for the harness's 14B) which garbles small models;
# this instance doesn't, so a fast 3B produces correct cleanup. Nothing here touches the
# system ollama.service, its models, or its config.
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=%h/.ollama-wf/models
Environment=OLLAMA_KV_CACHE_TYPE=f16
Environment=OLLAMA_FLASH_ATTENTION=0
Environment=OLLAMA_KEEP_ALIVE=5m
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
