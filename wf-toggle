#!/usr/bin/env python3
"""Tiny client for the wisprflow daemon — this is what the GNOME hotkey runs.

Usage:  wf-toggle [toggle|start|stop|cancel|status|ping|shutdown|note|mode [clean|note|raw]|lang|meeting]
Default command is 'toggle'. `mode` alone cycles clean -> note -> raw; `mode raw` sets it. Uses only the standard library (no venv needed),
so it works when bound directly to a desktop keyboard shortcut.
"""
import os
import socket
import sys

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SOCK = os.path.join(RUNTIME, "wf-daemon.sock")


def main() -> int:
    cmd = (" ".join(sys.argv[1:]) or "toggle").encode()
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(5)
        s.connect(SOCK)
        s.sendall(cmd)
        print(s.recv(4096).decode("utf-8", "replace"))
        s.close()
        return 0
    except (FileNotFoundError, ConnectionRefusedError):
        sys.stderr.write(f"wf-toggle: daemon not running (no {SOCK})\n")
        return 1
    except Exception as e:  # noqa: BLE001
        sys.stderr.write(f"wf-toggle: {e!r}\n")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
